<component type="desktop-application">
  <id>io.github.fabox_os.PicassoSuite</id>
  <name>Picasso Suite</name>
  <summary>Non-linear video editor with a DaVinci Resolve-style interface</summary>
  <developer id="io.github.fabox-os">
    <name>Picasso Suite contributors</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>A video editor laid out like DaVinci Resolve, with Media, Photo, Cut, Edit, Fusion, Color, Fairlight and Deliver pages. It reads any format FFmpeg reads, exports H.264, H.265, AV1, VP9, ProRes, DNxHR and more, and opens DaVinci Resolve projects. Not affiliated with Blackmagic Design.</p>
  </description>
